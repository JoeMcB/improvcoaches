<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl lg:text-4xl font-bold text-gray-800 mb-4">
        Join ImprovCoaches.com
      </h1>
      <p class="text-lg text-gray-600">
        Connect with improv coaches and fellow performers
      </p>
    </div>

    <!-- Registration Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      <!-- Facebook Registration -->
      <div class="bg-white rounded-xl shadow-lg border">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-800">
            Create an Account with Facebook
          </h2>
        </div>
        <div class="p-6">
          <div class="w-full max-w-sm mx-auto">
            <%= render "shared/facebook_login" %>
          </div>
        </div>
      </div>

      <!-- Manual Registration -->
      <div class="bg-white rounded-xl shadow-lg border">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-800">
            Create an Account
          </h2>
        </div>
        <div class="p-6">
          <%= render 'register' %>
        </div>
      </div>
    </div>

    <!-- Coaching Info -->
    <div class="bg-white rounded-xl shadow-lg border">
      <div class="p-4 sm:p-6 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-800">
          Interested in Coaching?
        </h2>
      </div>
      <div class="p-4 sm:p-6">
        <p class="text-gray-600 leading-relaxed">
          Our real-life improv communities are important. That's why ImprovCoaches uses an invite system for new coaches. Any coach currently on the site can invite another user to become a coach. If you're interested in coaching, talk to coaches you like and see if they've got an invite you can use.
        </p>
      </div>
    </div>
  </div>
</div>
